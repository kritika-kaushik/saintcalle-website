---
import Layout from "../layouts/Layout.astro";

const projectTypes = [
  "Landscaping & Lawn Care",
  "Pressure Washing",
  "Gutter Cleaning",
  "Handyman & General Repairs",
  "Plumbing & Fixtures",
  "Home Improvements & Remodeling",
  "Property Maintenance",
  "Other / Not Sure Yet"
];
---

<Layout>
  <main>
    <!-- HERO -->
    <section class="contact-hero">
      <div class="hero-content">
        <p class="eyebrow">LET'S TALK ABOUT YOUR PROJECT</p>
        <h1>Tell us what<br /><em>you have in mind.</em></h1>
        <p>
          Whether it's routine property maintenance or a project you've
          been planning for a while, we'd love to hear about it.
          Tell us a little about what you need and request your free estimate.
        </p>
      </div>
    </section>

    <!-- CONTACT FORM SECTION -->
    <section class="contact-section">
      <div class="contact-grid">

        <!-- FORM -->
        <div class="form-column">
          <div class="form-heading">
            <p class="eyebrow">REQUEST AN ESTIMATE</p>
            <h2>Let's get <em>started.</em></h2>
            <p>
              Share a few details about your project. The more we know,
              the better we can understand how to help.
            </p>
          </div>

          <form id="estimate-form" class="estimate-form">
            <div class="form-row">
              <div class="field">
                <label for="firstName">First name *</label>
                <input id="firstName" name="firstName" type="text" required />
              </div>

              <div class="field">
                <label for="lastName">Last name *</label>
                <input id="lastName" name="lastName" type="text" required />
              </div>
            </div>

            <div class="form-row">
              <div class="field">
                <label for="email">Email address *</label>
                <input id="email" name="email" type="email" required />
              </div>

              <div class="field">
                <label for="phone">Phone number *</label>
                <input
                  id="phone"
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  required
                />
              </div>
            </div>

            <div class="field">
              <label for="zip">Property ZIP code *</label>
              <input
                id="zip"
                name="zip"
                type="text"
                inputmode="numeric"
                autocomplete="postal-code"
                maxlength="5"
                pattern="[0-9]{5}"
                placeholder="e.g. 98057"
                required
              />
            </div>

            <div class="field">
              <label for="projectType">What service are you interested in? *</label>
              <select id="projectType" name="projectType" required>
                <option value="">Select a service</option>
                {projectTypes.map((service) => (
                  <option value={service}>{service}</option>
                ))}
              </select>
            </div>

            <div class="field">
              <label for="description">Tell us about your project *</label>
              <textarea
                id="description"
                name="description"
                rows="5"
                placeholder="Describe the work you're looking to have done, the size of the project, any specific concerns, or other details that might help us understand your needs..."
                required
              ></textarea>
            </div>

            <div class="field">
              <label for="timeline">When would you like the work done?</label>
              <select id="timeline" name="timeline">
                <option value="">Select a timeframe</option>
                <option value="As soon as possible">As soon as possible</option>
                <option value="Within 2 weeks">Within 2 weeks</option>
                <option value="Within a month">Within a month</option>
                <option value="Within 3 months">Within 3 months</option>
                <option value="Flexible">I'm flexible</option>
                <option value="Just exploring">Just exploring options</option>
              </select>
            </div>

            <div class="field">
              <label for="contactPreference">Preferred way to reach you</label>
              <select id="contactPreference" name="contactPreference">
                <option value="">No preference</option>
                <option value="Phone">Phone call</option>
                <option value="Text">Text message</option>
                <option value="Email">Email</option>
              </select>
            </div>

            <label class="consent">
              <input type="checkbox" name="consent" required />
              <span>
                I agree to be contacted by Saintcalle Satisfaction LLC
                regarding my estimate request. *
              </span>
            </label>

            <button type="submit" class="submit-button">
              Submit Estimate Request <span>→</span>
            </button>

            <p class="form-disclaimer">
              Submitting this form does not obligate you to purchase any services.
              All estimates and project details are subject to confirmation.
            </p>

            <div id="form-result" class="form-result" role="status" hidden></div>
          </form>
        </div>

        <!-- CONTACT SIDEBAR -->
        <aside class="contact-sidebar">
          <div class="sidebar-card">
            <p class="eyebrow">GET IN TOUCH</p>
            <h3>We're here to help.</h3>
            <p>
              Have a question before requesting an estimate?
              Get in touch and tell us what you have in mind.
            </p>

            <div class="contact-detail">
              <span class="detail-label">SERVICE LOCATION</span>
              <strong>Renton, Washington</strong>
              <span>Serving surrounding communities</span>
            </div>

            <div class="contact-detail">
              <span class="detail-label">BUSINESS</span>
              <strong>Saintcalle Satisfaction LLC</strong>
              <span>Black-owned small business</span>
            </div>

            <div class="sidebar-divider"></div>

            <h4>Not sure what service you need?</h4>
            <p>
              That's okay. Describe the problem in the form and we'll
              help you figure out the next step.
            </p>

            <a href="/services/" class="sidebar-link">
              Explore our services <span>→</span>
            </a>
          </div>

          <div class="sidebar-note">
            <span class="note-icon">✦</span>
            <div>
              <strong>Your property. Our priority.</strong>
              <p>
                Personal service, thoughtful solutions, and pride
                in every project.
              </p>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <!-- WHAT HAPPENS NEXT -->
    <section class="next-steps">
      <div class="section-heading">
        <p class="eyebrow">WHAT HAPPENS NEXT</p>
        <h2>Simple from <em>start to finish.</em></h2>
      </div>

      <div class="steps-grid">
        <article class="step">
          <span>01</span>
          <h3>Tell us what you need</h3>
          <p>
            Submit your project details using the estimate request form.
          </p>
        </article>

        <article class="step">
          <span>02</span>
          <h3>We'll connect with you</h3>
          <p>
            We'll review your request and discuss the details of your project.
          </p>
        </article>

        <article class="step">
          <span>03</span>
          <h3>Review your estimate</h3>
          <p>
            We'll discuss the proposed work and any applicable pricing
            before moving forward.
          </p>
        </article>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="contact-cta">
      <p class="eyebrow">READY WHEN YOU ARE</p>
      <h2>Let's make your property<br /><em>feel like home.</em></h2>
      <a href="/services/" class="cta-button">Explore Our Services</a>
    </section>
  </main>
</Layout>

<script>
    const estimateForm = document.querySelector("#estimate-form");
    const formResult = document.querySelector("#form-result");

    if (estimateForm instanceof HTMLFormElement &&
        formResult instanceof HTMLDivElement) {
    estimateForm.addEventListener("submit", (event) => {
        event.preventDefault();

        if (!estimateForm.reportValidity()) return;

        formResult.hidden = false;
        formResult.textContent =
        "The form layout is ready, but email delivery has not been connected yet. Please check back soon.";

        formResult.className = "form-result notice";
    });
    }
</script>

<style>
  .contact-hero {
    padding: 5.5rem 8%;
    background: #18372e;
  }

  .hero-content {
    max-width: 760px;
    margin: 0 auto;
  }

  .eyebrow {
    color: #a88e60;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.17em;
  }

  .contact-hero .eyebrow {
    color: #d8c49a;
  }

  h1, h2, h3 {
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 500;
  }

  h1, h2, h3, h4 {
    color: #18372e;
  }

  h1 em, h2 em {
    color: #a88e60;
    font-weight: 400;
  }

  .contact-hero h1 {
    color: #fff;
    font-size: clamp(3rem, 6vw, 4.8rem);
    line-height: 1.15;
    margin: 1.25rem 0;
  }

  .contact-hero h1 em {
    color: #d8c49a;
  }

  .contact-hero p:last-child {
    max-width: 590px;
    color: rgba(255,255,255,0.78);
    font-size: 1rem;
    line-height: 1.85;
  }

  /* FORM SECTION */

  .contact-section {
    padding: 6rem 6%;
    background: #f7f5ef;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(260px, 0.8fr);
    gap: 4rem;
    max-width: 1180px;
    margin: 0 auto;
    align-items: start;
  }

  .form-heading {
    margin-bottom: 2rem;
  }

  .form-heading h2 {
    font-size: 2.8rem;
    margin: 0.5rem 0 1rem;
  }

  .form-heading > p:last-child {
    color: #727b73;
    line-height: 1.7;
    max-width: 570px;
  }

  .estimate-form {
    padding: 2.25rem;
    background: #fff;
    border: 1px solid rgba(24,55,46,0.1);
    border-radius: 8px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .field {
    margin-bottom: 1.35rem;
  }

  .field label {
    display: block;
    margin-bottom: 0.55rem;
    color: #26332d;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .field input,
  .field select,
  .field textarea {
    box-sizing: border-box;
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid #d8ddd8;
    border-radius: 5px;
    background: #fff;
    color: #26332d;
    font: inherit;
    font-size: 0.9rem;
  }

  .field textarea {
    resize: vertical;
    line-height: 1.6;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: 2px solid #83b99a;
    outline-offset: 2px;
  }

  .consent {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    margin: 0.5rem 0 1.5rem;
    color: #727b73;
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .consent input {
    margin-top: 0.2rem;
    accent-color: #18372e;
  }

  .submit-button {
    display: flex;
    width: 100%;
    justify-content: center;
    align-items: center;
    gap: 0.8rem;
    padding: 1.1rem;
    border: none;
    border-radius: 5px;
    background: #18372e;
    color: #fff;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }

  .submit-button:hover {
    background: #285344;
  }

  .form-disclaimer {
    margin: 1rem 0 0;
    color: #858b85;
    font-size: 0.72rem;
    line-height: 1.6;
    text-align: center;
  }

  .form-result {
    margin-top: 1.25rem;
    padding: 1rem;
    border-radius: 5px;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .form-result.notice {
    background: #f7f5ef;
    border: 1px solid #ddd6c8;
    color: #59645d;
  }

  /* SIDEBAR */

  .contact-sidebar {
    position: sticky;
    top: 2rem;
  }

  .sidebar-card {
    padding: 2rem;
    background: #fff;
    border: 1px solid rgba(24,55,46,0.1);
    border-radius: 8px;
  }

  .sidebar-card h3 {
    font-size: 1.8rem;
    margin: 0.5rem 0 1rem;
  }

  .sidebar-card > p:not(.eyebrow) {
    color: #727b73;
    font-size: 0.87rem;
    line-height: 1.8;
  }

  .contact-detail {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 1.7rem;
  }

  .detail-label {
    color: #a88e60;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .contact-detail strong {
    color: #18372e;
    font-size: 0.9rem;
  }

  .contact-detail > span:last-child {
    color: #727b73;
    font-size: 0.8rem;
  }

  .sidebar-divider {
    height: 1px;
    margin: 1.8rem 0;
    background: #e8e9e4;
  }

  .sidebar-card h4 {
    margin: 0 0 0.6rem;
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.25rem;
    font-weight: 500;
  }

  .sidebar-link {
    display: inline-block;
    margin-top: 0.8rem;
    color: #18372e;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }

  .sidebar-link span {
    margin-left: 0.4rem;
  }

  .sidebar-note {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    margin-top: 1.25rem;
    padding: 1.5rem;
    background: #18372e;
    border-radius: 8px;
  }

  .note-icon {
    color: #d8c49a;
    font-size: 1.4rem;
  }

  .sidebar-note strong {
    color: #fff;
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.1rem;
    font-weight: 500;
  }

  .sidebar-note p {
    margin: 0.5rem 0 0;
    color: rgba(255,255,255,0.72);
    font-size: 0.8rem;
    line-height: 1.7;
  }

  /* NEXT STEPS */

  .next-steps {
    padding: 6rem 7%;
    background: #fff;
  }

  .section-heading {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 2.8rem;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .step {
    padding: 1.5rem;
    border-top: 2px solid #d8c49a;
  }

  .step > span {
    color: #a88e60;
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.8rem;
  }

  .step h3 {
    margin: 1rem 0 0.6rem;
    font-size: 1.35rem;
  }

  .step p {
    color: #727b73;
    font-size: 0.87rem;
    line-height: 1.8;
  }

  /* CTA */

  .contact-cta {
    padding: 5rem 7%;
    background: #f7f5ef;
    text-align: center;
  }

  .contact-cta h2 {
    font-size: clamp(2.3rem, 5vw, 3.5rem);
    margin: 1rem 0 2rem;
  }

  .cta-button {
    display: inline-block;
    padding: 1rem 1.5rem;
    border-radius: 5px;
    background: #18372e;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }

  .cta-button:hover {
    background: #285344;
  }

  /* MOBILE */

  @media (max-width: 850px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .contact-sidebar {
      position: static;
    }

    .steps-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  @media (max-width: 560px) {
    .contact-hero {
      padding: 4rem 7%;
    }

    .contact-section {
      padding: 4rem 5%;
    }

    .form-row {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .estimate-form {
      padding: 1.4rem;
    }

    .form-heading h2,
    .section-heading h2 {
      font-size: 2.2rem;
    }
  }
</style>
