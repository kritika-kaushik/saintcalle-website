
---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    number: '01',
    title: 'Landscaping & Outdoor Care',
    description: 'Keep your outdoor spaces looking their best, from lawn maintenance to seasonal cleanups.',
    image: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=900&q=85',
    tag: 'Outdoor care'
  },
  {
    number: '02',
    title: 'Pressure Washing & Cleaning',
    description: 'Refresh driveways, patios, exterior surfaces and other areas around your property.',
    image: 'https://images.unsplash.com/photo-1603712725038-e9334ae8f39f?auto=format&fit=crop&w=1200&q=85',
    tag: 'Exterior care'
  },
  {
    number: '03',
    title: 'Handyman & Home Repairs',
    description: 'Tackle those everyday repairs, installations and maintenance jobs around your home.',
    image: 'https://images.unsplash.com/photo-1621905251189-08b45d6a269e?w=900&q=85',
    tag: 'Home maintenance'
  },
  {
    number: '04',
    title: 'Plumbing & Fixtures',
    description: 'Get help with suitable household plumbing repairs, fixture replacements and upgrades.',
    image: 'https://images.unsplash.com/photo-1620626011761-996317b8d101?w=900&q=85',
    tag: 'Home repairs'
  },
  {
    number: '05',
    title: 'Remodeling & Improvements',
    description: 'Bring new life to your space with home improvement and renovation projects.',
    image: 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=900&q=85',
    tag: 'Home improvement'
  },
  {
    number: '06',
    title: 'Specialty Projects',
    description: 'Have something different in mind? Tell us about your project and let’s discuss it.',
    image: 'https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?w=900&q=85',
    tag: 'Custom projects'
  }
];

const steps = [
  {
    number: '01',
    title: 'Tell us what you need',
    description: 'Share a few details about your home, maintenance needs or upcoming project.'
  },
  {
    number: '02',
    title: 'Get a personalized estimate',
    description: 'We review your request and discuss the scope, timing and next steps.'
  },
  {
    number: '03',
    title: 'Let’s get it done',
    description: 'Once everything is agreed upon, we coordinate the work and get started.'
  }
];
---

<Layout>
  <main>
    <!-- HERO -->
    <section class="hero" id="home">
      <div class="hero-overlay"></div>

      <div class="container hero-content">
        <span class="hero-eyebrow">
          HOME IMPROVEMENT · MAINTENANCE · PROPERTY CARE
        </span>

        <h1>
          Your property.<br />
          <em>Our priority.</em>
        </h1>

        <p>
          From seasonal outdoor care to the repairs and improvements
          that make a house feel like home. We're here to help.
        </p>

        <div class="hero-actions">
          <a href="#contact" class="btn btn-gold">
            REQUEST A FREE ESTIMATE <span>↗</span>
          </a>
          <a href="#services" class="hero-secondary">
            EXPLORE OUR SERVICES ↓
          </a>
        </div>

        <div class="hero-bottom">
          <span>ONE CALL. A WHOLE LOT LESS TO WORRY ABOUT.</span>
          <span>SAINTCALLE SATISFACTION LLC</span>
        </div>
      </div>
    </section>

    <!-- INTRODUCTION -->
    <section class="intro section">
      <div class="container intro-grid">
        <div>
          <span class="section-label">A BETTER WAY TO CARE FOR YOUR HOME</span>
          <h2 class="section-heading">
            The little things.<br />
            The big projects.<br />
            <em>We've got you.</em>
          </h2>
        </div>

        <div class="intro-copy">
          <p>
            Maintaining a home takes time, effort and the right helping
            hands. Whether it's keeping your outdoor spaces in shape,
            tackling a repair or planning an improvement, finding someone
            you can call shouldn't be another project.
          </p>
          <p>
            Saintcalle Satisfaction LLC brings a range of property
            maintenance and home improvement services together under one roof.
          </p>
          <a href="#about" class="text-link">GET TO KNOW US ↗</a>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="services section" id="services">
      <div class="container">
        <div class="section-top">
          <div>
            <span class="section-label">WHAT WE CAN HELP WITH</span>
            <h2 class="section-heading">
              One team.<br />
              <em>Many ways to help.</em>
            </h2>
          </div>
          <p class="section-description">
            From routine property upkeep to projects that need a little
            extra attention, explore the services we offer.
          </p>
        </div>

        <div class="service-grid">
          {services.map((service) => (
            <article class="service-card">
              <a href="#contact" aria-label={`Enquire about ${service.title}`}>
                <div class="service-image">
                  <img src={service.image} alt="" loading="lazy" />
                  <span class="service-number">{service.number}</span>
                  <span class="service-arrow">↗</span>
                </div>
                <div class="service-content">
                  <span class="service-tag">{service.tag}</span>
                  <h3>{service.title}</h3>
                  <p>{service.description}</p>
                  <span class="service-link">ASK ABOUT THIS SERVICE ↗</span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="about section" id="about">
      <div class="container about-grid">
        <div class="about-image">
          <img
            src="https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?w=1200&q=85"
            alt="Beautifully maintained modern residential interior"
            loading="lazy"
          />
          <div class="image-note">
            <strong>SAINTCALLE SATISFACTION LLC</strong>
            <span>Quality in every detail.</span>
          </div>
        </div>

        <div class="about-content">
          <span class="section-label">THE PEOPLE BEHIND THE WORK</span>
          <h2 class="section-heading">
            Good work starts<br />
            with <em>good people.</em>
          </h2>
          <p>
            Every home deserves attention and every project deserves
            a thoughtful approach.
          </p>
          <p>
            Saintcalle Satisfaction LLC is built around helping homeowners
            take care of the spaces they value. From everyday maintenance
            to new ideas and improvements, we're here to make the process
            straightforward.
          </p>
          <a href="#contact" class="btn btn-primary">LET'S TALK ABOUT YOUR PROJECT ↗</a>
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="process section">
      <div class="container">
        <div class="center-heading">
          <span class="section-label">SIMPLE FROM START TO FINISH</span>
          <h2 class="section-heading">Getting started is <em>easy.</em></h2>
          <p>Three simple steps to move your next project forward.</p>
        </div>

        <div class="process-grid">
          {steps.map((step) => (
            <article class="process-card">
              <span class="process-number">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- PROJECTS / VISUAL SHOWCASE -->
    <section class="showcase section" id="projects">
      <div class="container showcase-grid">
        <div class="showcase-copy">
          <span class="section-label">YOUR NEXT PROJECT STARTS HERE</span>
          <h2 class="section-heading">
            What's on your<br />
            <em>to-do list?</em>
          </h2>
          <p>
            That repair you've been putting off? The outdoor space
            you've been wanting to refresh? The home improvement you've
            been planning?
          </p>
          <p>
            Tell us what you have in mind. Let's figure out the next step.
          </p>
          <a href="#contact" class="btn btn-primary">TELL US ABOUT IT ↗</a>
        </div>

        <div class="showcase-images">
          <img
            src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?w=900&q=85"
            alt="Contemporary residential home improvement inspiration"
            loading="lazy"
          />
          <img
            src="https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?w=900&q=85"
            alt="Modern home interior inspiration"
            loading="lazy"
          />
        </div>
      </div>
      <div class="container showcase-disclaimer">
        <span>Illustrative imagery — replace with actual business project photos.</span>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="contact section" id="contact">
      <div class="container contact-grid">
        <div class="contact-copy">
          <span class="section-label">LET'S GET TO WORK</span>
          <h2 class="section-heading">
            Tell us what<br />
            <em>you have in mind.</em>
          </h2>
          <p>
            Have a project coming up or need a hand with something around
            the house? Send us a few details and we'll be in touch.
          </p>

          <div class="contact-promise">
            <span>✓</span> No-obligation estimate requests
          </div>
          <div class="contact-promise">
            <span>✓</span> Personalized project discussions
          </div>
          <div class="contact-promise">
            <span>✓</span> A straightforward process
          </div>
        </div>

        <form class="contact-form" id="enquiry-form">
          <h3>Request an estimate</h3>
          <p>Tell us a little about your project.</p>

          <label for="customer-name">Your name</label>
          <input id="customer-name" name="name" type="text"
            placeholder="Full name" required />

          <label for="customer-email">Email address</label>
          <input id="customer-email" name="email" type="email"
            placeholder="you@example.com" required />

          <label for="customer-phone">Phone number</label>
          <input id="customer-phone" name="phone" type="tel"
            placeholder="Your phone number" />

          <label for="service-type">What do you need help with?</label>
          <select id="service-type" name="service" required>
            <option value="">Select a service</option>
            {services.map((service) => (
              <option value={service.title}>{service.title}</option>
            ))}
            <option value="Something else">Something else</option>
          </select>

          <label for="project-message">Tell us about your project</label>
          <textarea id="project-message" name="message"
            rows="4" placeholder="A few details about what you need..."
            required></textarea>

          <button class="btn btn-primary form-submit" type="submit">
            SEND MY ENQUIRY ↗
          </button>

          <p class="form-note">
            Demo form only. Email delivery will be connected before launch.
          </p>

          <p class="form-success" id="form-success" role="status" hidden>
            Thanks! This is a prototype — your enquiry has not actually
            been sent yet.
          </p>
        </form>
      </div>
    </section>
  </main>

</Layout>

<script>
  const enquiryForm = document.querySelector('#enquiry-form');
  const successMessage = document.querySelector('#form-success');

  enquiryForm?.addEventListener('submit', (event) => {
    event.preventDefault();

    if (!(enquiryForm instanceof HTMLFormElement)) return;
    if (!enquiryForm.reportValidity()) return;

    if (successMessage) {
      successMessage.removeAttribute('hidden');
    }

    enquiryForm.reset();
  });
</script>

<style>
  /* HERO */
  .hero {
    position: relative;
    min-height: 650px;
    display: flex;
    align-items: center;
    color: white;
    background:
      url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=2000&q=90')
      center 55% / cover no-repeat;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(15, 35, 28, .93),
      rgba(15, 35, 28, .70) 55%,
      rgba(15, 35, 28, .22)
    );
  }

  .hero-content {
    position: relative;
    padding-top: 80px;
    padding-bottom: 80px;
  }

  .hero-eyebrow {
    color: var(--color-brass);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .16em;
  }

  .hero h1 {
    margin: 25px 0;
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 7vw, 6rem);
    line-height: 1.06;
    font-weight: 500;
  }

  .hero h1 em, .section-heading em {
    color: var(--color-brass);
    font-weight: 500;
  }

  .hero-content > p {
    max-width: 510px;
    color: #e3e9e4;
    font-size: 16px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 25px;
    margin-top: 35px;
  }

  .btn-gold {
    background: var(--color-brass);
    color: var(--color-forest);
  }

  .btn-gold:hover {
    background: white;
  }

  .hero-secondary {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
  }

  .hero-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 90px;
    padding-top: 20px;
    border-top: 1px solid rgba(255,255,255,.3);
    color: #e1e6e1;
    font-size: 10px;
    letter-spacing: .1em;
  }

  /* INTRO */
  .intro-grid {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 100px;
    align-items: center;
  }

  .intro-copy p, .about-content p, .showcase-copy p {
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.9;
  }

  .text-link {
    display: inline-block;
    margin-top: 18px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .08em;
    color: var(--color-forest);
  }

  /* SERVICES */
  .services {
    background: white;
  }

  .section-top {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 50px;
    margin-bottom: 45px;
  }

  .section-top .section-description {
    max-width: 370px;
    padding-bottom: 20px;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
  }

  .service-card {
    background: var(--color-ivory);
    overflow: hidden;
    border-radius: var(--radius-card);
    transition: transform .25s ease, box-shadow .25s ease;
  }

  .service-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-card);
  }

  .service-image {
    position: relative;
    height: 220px;
    overflow: hidden;
  }

  .service-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s ease;
  }

  .service-card:hover .service-image img {
    transform: scale(1.06);
  }

  .service-number, .service-arrow {
    position: absolute;
    top: 15px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: white;
    color: var(--color-forest);
    font-size: 12px;
    font-weight: 700;
  }

  .service-number { left: 15px; }
  .service-arrow { right: 15px; font-size: 17px; }

  .service-content {
    padding: 25px;
  }

  .service-tag {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--color-forest-light);
    font-weight: 800;
  }

  .service-content h3 {
    font-family: var(--font-heading);
    font-size: 23px;
    font-weight: 500;
    line-height: 1.3;
    min-height: 60px;
  }

  .service-content p {
    color: var(--color-muted);
    font-size: 13px;
    min-height: 65px;
  }

  .service-link {
    display: inline-block;
    margin-top: 10px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .07em;
  }

  /* ABOUT */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 90px;
  }

  .about-image {
    position: relative;
  }

  .about-image > img {
    width: 100%;
    height: 490px;
    object-fit: cover;
    border-radius: var(--radius-card);
  }

  .image-note {
    position: absolute;
    bottom: 25px;
    left: 25px;
    padding: 18px 22px;
    background: var(--color-forest);
    color: white;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .image-note strong {
    font-size: 11px;
    letter-spacing: .1em;
  }

  .image-note span {
    color: var(--color-brass);
    font-size: 12px;
  }

  .about-content .btn {
    margin-top: 20px;
  }

  /* PROCESS */
  .process {
    background: #eeede5;
  }

  .center-heading {
    text-align: center;
    margin-bottom: 50px;
  }

  .center-heading p {
    color: var(--color-muted);
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .process-card {
    padding: 30px;
    border-top: 1px solid #c9c8bc;
  }

  .process-number {
    color: #9c895e;
    font-family: var(--font-heading);
    font-size: 35px;
  }

  .process-card h3 {
    font-family: var(--font-heading);
    font-size: 23px;
    font-weight: 500;
  }

  .process-card p {
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.8;
  }

  /* SHOWCASE */
  .showcase {
    background: white;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    align-items: center;
    gap: 70px;
  }

  .showcase-images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
  }

  .showcase-images img {
    width: 100%;
    height: 330px;
    object-fit: cover;
    border-radius: 10px;
  }

  .showcase-images img:last-child {
    margin-top: 40px;
  }

  .showcase-disclaimer {
    margin-top: 15px;
    text-align: right;
    color: var(--color-muted);
    font-size: 11px;
  }

  .showcase-copy .btn {
    margin-top: 20px;
  }

  /* CONTACT */
  .contact {
    background: var(--color-ivory);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: 90px;
    align-items: start;
  }

  .contact-copy > p {
    color: var(--color-muted);
    line-height: 1.9;
  }

  .contact-promise {
    margin-top: 20px;
    font-size: 13px;
    font-weight: 600;
  }

  .contact-promise span {
    margin-right: 10px;
    color: #9c895e;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 35px;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .contact-form h3 {
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 500;
    margin: 0;
  }

  .contact-form > p {
    margin: 0 0 15px;
    color: var(--color-muted);
    font-size: 13px;
  }

  .contact-form label {
    margin-top: 9px;
    font-size: 12px;
    font-weight: 700;
  }

  .contact-form input, .contact-form select,
  .contact-form textarea {
    width: 100%;
    padding: 13px;
    border: 1px solid var(--color-border);
    border-radius: 5px;
    background: #fcfcfa;
    color: var(--color-text);
    font-size: 13px;
  }

  .contact-form textarea {
    resize: vertical;
  }

  .contact-form input:focus, .contact-form select:focus,
  .contact-form textarea:focus {
    outline: 2px solid var(--color-brass);
    border-color: var(--color-forest);
  }

  .form-submit {
    width: 100%;
    margin-top: 15px;
  }

  .contact-form .form-note {
    font-size: 11px;
    text-align: center;
  }

  .contact-form .form-success {
    padding: 12px;
    background: #e8f1e9;
    color: var(--color-forest);
    border-radius: 5px;
    font-size: 12px;
  }

  @media (max-width: 900px) {
    .intro-grid, .about-grid, .showcase-grid, .contact-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .service-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .about-image > img {
      height: 400px;
    }
  }

  @media (max-width: 600px) {
    .hero {
      min-height: 600px;
    }

    .hero-bottom {
      flex-direction: column;
      margin-top: 60px;
    }

    .hero-actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .section-top {
      align-items: flex-start;
      flex-direction: column;
      gap: 0;
    }

    .service-grid, .process-grid {
      grid-template-columns: 1fr;
    }

    .service-image {
      height: 240px;
    }

    .showcase-images img {
      height: 230px;
    }

    .contact-form {
      padding: 23px;
    }
  }
</style>
