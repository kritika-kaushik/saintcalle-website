<div class="service-checker">
  <div class="checker-heading">
    <p class="eyebrow">CHECK YOUR LOCATION</p>
    <h3>Do we service your area?</h3>
    <p>Enter your ZIP code to see whether your property is within our standard service radius.</p>
  </div>

  <form id="service-area-form" class="checker-form">
    <label for="service-zip">Your ZIP code</label>
    <div class="input-row">
      <input
        id="service-zip"
        name="zip"
        type="text"
        inputmode="numeric"
        autocomplete="postal-code"
        maxlength="5"
        pattern="[0-9]{5}"
        placeholder="e.g. 98057"
        required
      />
      <button type="submit">Check Availability</button>
    </div>
  </form>

  <div id="service-result" class="service-result" aria-live="polite" hidden>
    <h4 id="result-title"></h4>
    <p id="result-message"></p>
    <a href="/contact/" class="result-link">Request a Free Estimate</a>
  </div>

  <p class="checker-note">
    Service eligibility is estimated using the ZIP code's geographic center
    and a 100-mile radius from Renton, Washington. Actual availability may
    vary by project.
  </p>
</div>

<script lang="ts">

    document.addEventListener("submit", async (event) => {
    const form = event.target;

    // Only handle our service-area form
    if (!form || form.id !== "service-area-form") return;

    // Stop the browser from refreshing the page
    event.preventDefault();

    const zipInput = document.querySelector("#service-zip");
    const result = document.querySelector("#service-result");
    const resultTitle = document.querySelector("#result-title");
    const resultMessage = document.querySelector("#result-message");
    const submitButton = form.querySelector('button[type="submit"]');

    if (!zipInput || !result || !resultTitle || !resultMessage || !submitButton) {
        console.error("Service area checker: One or more form elements are missing.");
        return;
    }

    const zip = zipInput.value.trim();

    // Validate ZIP code
    if (!/^\d{5}$/.test(zip)) {
        showResult(
        "Please enter a valid ZIP code",
        "Enter a five-digit US ZIP code and try again.",
        "outside"
        );
        return;
    }

    result.hidden = true;
    submitButton.disabled = true;
    submitButton.textContent = "Checking...";

    try {
        const response = await fetch(
        `https://api.zippopotam.us/us/${encodeURIComponent(zip)}`
        );

        if (!response.ok) {
        throw new Error("ZIP code not found.");
        }

        const data = await response.json();
        const place = data.places?.[0];

        if (!place) {
        throw new Error("Location information unavailable.");
        }

        const latitude = Number(place.latitude);
        const longitude = Number(place.longitude);

        if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) {
        throw new Error("Invalid location coordinates.");
        }

        const distance = distanceMiles(
        47.4829,
        -122.2171,
        latitude,
        longitude
        );

        const city = place["place name"];
        const state = place["state abbreviation"];

        if (distance <= 100) {
        showResult(
            "Good news! You're within our service area.",
            `${city}, ${state} is approximately ${Math.round(distance)} miles from Renton. Contact us to discuss your project and request a free estimate.`,
            "covered"
        );
        } else {
        showResult(
            "You're outside our standard service radius.",
            `${city}, ${state} is approximately ${Math.round(distance)} miles from Renton. We may still be able to help depending on your project, so feel free to contact us.`,
            "outside"
        );
        }
    } catch (error) {
        console.error("ZIP code lookup failed:", error);

        showResult(
        "We couldn't verify that ZIP code.",
        "Please check the ZIP code and try again. You can also contact us directly to confirm service availability.",
        "outside"
        );
    } finally {
        submitButton.disabled = false;
        submitButton.textContent = "Check Availability";
    }
    });

    function distanceMiles(lat1, lon1, lat2, lon2) {
    const toRadians = (degrees) => degrees * Math.PI / 180;
    const earthRadiusMiles = 3958.8;

    const dLat = toRadians(lat2 - lat1);
    const dLon = toRadians(lon2 - lon1);

    const a =
        Math.sin(dLat / 2) ** 2 +
        Math.cos(toRadians(lat1)) *
        Math.cos(toRadians(lat2)) *
        Math.sin(dLon / 2) ** 2;

    return earthRadiusMiles * 2 *
        Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    function showResult(title, message, status) {
    const result = document.querySelector("#service-result");
    const resultTitle = document.querySelector("#result-title");
    const resultMessage = document.querySelector("#result-message");

    if (!result || !resultTitle || !resultMessage) return;

    result.hidden = false;
    result.className = `service-result ${status}`;
    resultTitle.textContent = title;
    resultMessage.textContent = message;
    }
</script>

