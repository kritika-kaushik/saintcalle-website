
<header class="header">
  <div class="container header-inner">
    <a href="#home" class="brand" aria-label="Saintcalle Satisfaction home">
      <span class="brand-mark">S</span>
      <span class="brand-name">
        <strong>SAINTCALLE</strong>
        <small>SATISFACTION LLC</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      <a href={import.meta.env.BASE_URL}>Home</a>
      <a href={import.meta.env.BASE_URL + '/services'}>Services</a>
      <a href={import.meta.env.BASE_URL + '/about'}>About</a>
      <a href={import.meta.env.BASE_URL + '/projects'}>Our Work</a>
      <a href={import.meta.env.BASE_URL + '/contact'}>Contact</a>
    </nav>

    <a class="header-cta" href={import.meta.env.BASE_URL + '/contact'}>GET A FREE ESTIMATE <span>↗</span></a>

    <button class="menu-toggle" aria-label="Open navigation menu"
      aria-expanded="false" aria-controls="mobile-nav">
      <span></span>
      <span></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" hidden>
    <a href="#home">Home</a>
    <a href="#services">Services</a>
    <a href="#about">About</a>
    <a href="#projects">Our Work</a>
    <a href="#contact">Contact</a>
    <a href="#contact" class="mobile-cta">Request an Estimate ↗</a>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-ivory);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
  }

  .brand-mark {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid var(--color-brass);
    border-radius: 7px;
    color: var(--color-forest);
    font-family: var(--font-heading);
    font-size: 25px;
  }

  .brand-name {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .brand-name strong {
    color: var(--color-forest);
    font-size: 15px;
    letter-spacing: .09em;
  }

  .brand-name small {
    color: var(--color-muted);
    font-size: 9px;
    letter-spacing: .19em;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .desktop-nav a {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text);
    transition: color .2s;
  }

  .desktop-nav a:hover {
    color: var(--color-forest-light);
  }

  .header-cta, .mobile-cta {
    background: var(--color-forest);
    color: white;
    padding: 13px 17px;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .03em;
  }

  .header-cta span {
    margin-left: 8px;
    color: var(--color-brass);
  }

  .menu-toggle {
    display: none;
    border: 0;
    background: transparent;
    padding: 10px;
  }

  .menu-toggle span {
    display: block;
    width: 23px;
    height: 2px;
    margin: 5px;
    background: var(--color-forest);
  }

  .mobile-nav {
    padding: 15px 24px 25px;
    background: var(--color-ivory);
    border-top: 1px solid var(--color-border);
  }

  .mobile-nav a:not(.mobile-cta) {
    display: block;
    padding: 13px 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 14px;
    font-weight: 600;
  }

  .mobile-cta {
    display: block;
    margin-top: 17px;
    text-align: center;
  }

  @media (max-width: 900px) {
    .desktop-nav, .header-cta {
      display: none;
    }

    .menu-toggle {
      display: block;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const mobileNav = document.querySelector('#mobile-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';

    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute(
      'aria-label',
      isOpen ? 'Open navigation menu' : 'Close navigation menu'
    );

    mobileNav?.toggleAttribute('hidden', isOpen);
  });

  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileNav.setAttribute('hidden', '');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Open navigation menu');
    });
  });
</script>
